#![enable(implicit_some)]
// Original assets imported from ~/lp_extract. The procedural generators
// remain as fallbacks. See original/import-report.json and docs/ASSETS.md.
(
  entries: {
    // ------------------------------------------------------------- music / ambience
    "music.lamp": (path: "original/audio/lamp_Lamplighter_Music.ogg", procedural: "pad_wonder", volume: 0.7, looped: true, note: "Lamplighter music (original: start delay 6 s, duck under dialogue)"),
    "amb.lamp.sea": (path: "original/audio/lamp_Sea_Waves_Loop.ogg", procedural: "wind", volume: 0.3, looped: true, note: "sea breeze bed"),

    // ---------------------------------------------------------------- characters
    "model.lamp.lamplighter": (path: "original/lamp/lamp_lamplighter.glb", procedural: "lamp.lamplighter", note: "the lamplighter, faces +Z; named parts 'body', 'head' (neck pivot y 1.42), 'arm' + 'tip' (right arm and wand, shoulder pivot (-0.2, 1.32, 0.05), modelled RAISED so the wand tip reaches (0.06, 2.92, 0.96)), 'arm_l'"),

    // --------------------------------------------------------------------- props
    "model.lamp.street_lamp": (path: "original/lamp/lamp_street_lamp.glb", procedural: "lamp.street_lamp", note: "street lamp; lantern centre (wick) 2.92 m above the foot; named parts 'glass', 'flame', 'halo'"),
    "model.lamp.seat": (path: "original/lamp/lamp_seat.glb", procedural: "lamp.seat", note: "the sunset seat: rock ledge, flat top 0.42 m up"),
    "model.lamp.tide_pool": (path: "original/lamp/lamp_tide_pool.glb", procedural: "lamp.tide_pool", note: "tide pool r 0.8 with a boulder rim"),
    "model.lamp.stone": (path: "original/lamp/lamp_stone.glb", procedural: "lamp.stone", note: "flat stepping stone of the path / landing stone"),
    "model.lamp.boulder": (path: "original/lamp/lamp_boulder.glb", procedural: "lamp.boulder", note: "boulders on the island's steep sides (Kenney Nature Kit, CC0)"),
    "model.lamp.bush": (path: "original/b612/lamp_bush.glb", procedural: "bush", note: "island cover (Kenney Nature Kit, CC0)"),
    "model.lamp.cloud": (procedural: "lamp.cloud", note: "cloud puff of the cloud sea at the horizon (scaled ×9-18)"),
    "tex.lamp.star": (procedural: "flare", note: "the 'first star' that wakes when the lamp is lit; square RGBA PNG"),

    // -------------------------------------------------------------------- sounds
    "sfx.lamp.light": (path: "original/audio/lamp_Lamp_Light.ogg", procedural: "chime_low", volume: 0.6, note: "the wick catches"),
    "sfx.lamp.out": (path: "original/audio/lamp_Lamp_PutOut.ogg", procedural: "pop", volume: 0.6, note: "the snuffer"),
    "sfx.lamp.surf": (path: "original/audio/lamp_Sea_Waves_Loop.ogg", procedural: "water", volume: 0.5, note: "a wave on the rocks"),
  },
)
