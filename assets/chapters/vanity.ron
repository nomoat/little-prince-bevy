#![enable(implicit_some)]
// Original assets imported from ~/lp_extract. The procedural generators
// remain as fallbacks. See original/import-report.json and docs/ASSETS.md.
(
  entries: {
    "music.vanity": (path: "original/audio/theater_Theater_Music.ogg", procedural: "pad_playful", volume: 0.7, looped: true),
    "model.vanity.theatre": (path: "original/theater/vanity_theatre.glb", procedural: "vanity.theatre", note: "the old theatre shell, world frame: door plane z=0, hall x±7.4 z 0.6..17.6, stage top y=0.9 (colliders stay code-defined)"),
    "model.vanity.door_leaf": (procedural: "vanity.door_leaf", note: "one door leaf 1.6 x 3.1 m, centred on its origin in x, bottom at y=0"),
    "model.vanity.seat_row": (procedural: "vanity.seat_row", note: "half row of six child-size theatre chairs (seat 0.30 m), 1 m apart, facing +z"),
    "model.vanity.vain": (path: "original/theater/vanity_vain.glb", procedural: "vanity.vain", note: "the conceited man ~1.95 m incl. hat, faces +z; named parts torso/head/arm_l/arm_r/hat are animated"),
    "model.vanity.mirror": (path: "original/theater/vanity_mirror.glb", procedural: "vanity.mirror", note: "standing mirror ~3 m, faces +z"),
    "model.vanity.footlights": (procedural: "vanity.footlights", note: "row of stage footlights, 13 m"),
    "model.vanity.poster": (procedural: "vanity.poster", note: "playbill 1.3 x 1.7 m"),
    "model.vanity.pennant": (procedural: "vanity.pennant", note: "ridge pennant"),
    // dry hand claps: generated WAVs (scripts in tests/gen_vbg_sfx.py), CC0 by this project
    "sfx.vanity.clap0": (variants: ["original/audio/theater_Clap_0.ogg", "original/audio/theater_Clap_1.ogg", "original/audio/theater_Clap_2.ogg", "original/audio/theater_Clap_3.ogg", "original/audio/theater_Clap_4.ogg", "original/audio/theater_Clap_5.ogg", "original/audio/theater_Clap_6.ogg", "original/audio/theater_Clap_7.ogg"], procedural: "clap", volume: 1.0),
    "sfx.vanity.clap1": (variants: ["original/audio/theater_Clap_0.ogg", "original/audio/theater_Clap_1.ogg", "original/audio/theater_Clap_2.ogg", "original/audio/theater_Clap_3.ogg", "original/audio/theater_Clap_4.ogg", "original/audio/theater_Clap_5.ogg", "original/audio/theater_Clap_6.ogg", "original/audio/theater_Clap_7.ogg"], procedural: "clap", volume: 1.0),
    "sfx.vanity.clap2": (variants: ["original/audio/theater_Clap_0.ogg", "original/audio/theater_Clap_1.ogg", "original/audio/theater_Clap_2.ogg", "original/audio/theater_Clap_3.ogg", "original/audio/theater_Clap_4.ogg", "original/audio/theater_Clap_5.ogg", "original/audio/theater_Clap_6.ogg", "original/audio/theater_Clap_7.ogg"], procedural: "clap", volume: 1.0),
    "sfx.vanity.clap3": (variants: ["original/audio/theater_Clap_0.ogg", "original/audio/theater_Clap_1.ogg", "original/audio/theater_Clap_2.ogg", "original/audio/theater_Clap_3.ogg", "original/audio/theater_Clap_4.ogg", "original/audio/theater_Clap_5.ogg", "original/audio/theater_Clap_6.ogg", "original/audio/theater_Clap_7.ogg"], procedural: "clap", volume: 1.0),
  },
