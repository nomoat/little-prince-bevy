#![enable(implicit_some)]
// Original assets imported from ~/lp_extract. The procedural generators
// remain as fallbacks. See original/import-report.json and docs/ASSETS.md.
(
  entries: {
    // ------------------------------------------------------------- music / ambience
    "music.businessman": (path: "original/audio/counting_StarObservatory_Music.ogg", procedural: "pad_night", volume: 0.7, looped: true, note: "StarObservatory music (original: start delay 6 s, duck under dialogue)"),
    "amb.businessman.night": (procedural: "night", volume: 0.25, looped: true, note: "night air around the observatory"),

    // ------------------------------------------------------------------ building
    "model.businessman.observatory": (path: "original/counting/businessman_observatory.glb", procedural: "businessman.observatory", note: "plinth (floor 0.36 m up), round wall r 3.25-3.5 m, south doorway 1.7 x 2.25 m, cornice"),
    "model.businessman.dome": (path: "original/counting/businessman_dome.glb", procedural: "businessman.dome", note: "glass dome over the room; part 'glass' is transparent"),
    "model.businessman.door_leaf": (procedural: "businessman.door_leaf", note: "one door leaf, hinge at origin, extends 0.85 m along +X, 2.25 m high"),

    // ------------------------------------------------------------------- interior
    "model.businessman.telescope": (path: "original/counting/businessman_telescope.glb", procedural: "businessman.telescope", note: "brass telescope on a tripod; eyepiece at (0, 1.085, -0.451), tube 30° up toward +Z"),
    "model.businessman.rug": (path: "original/counting/businessman_rug.glb", procedural: "businessman.rug", note: "star rug under the telescope, r 1.35"),
    "model.businessman.desk": (path: "original/counting/businessman_desk.glb", procedural: "businessman.desk", note: "writing desk 1.5 x 0.78 m with ledger; named parts 'drawer' (slides +Z) and 'slip' (paper slip)"),
    "model.businessman.chair": (path: "original/counting/businessman_chair.glb", procedural: "businessman.chair", note: "the merchant's chair, seat 0.47 m, faces +Z"),
    "model.businessman.merchant": (path: "original/counting/businessman_merchant.glb", procedural: "businessman.merchant", note: "the businessman, seated, faces +Z; named parts 'head' (neck pivot at y 0.93), 'arm' (right shoulder), 'body'"),
    "model.businessman.bookshelf": (path: "original/counting/businessman_bookshelf.glb", procedural: "businessman.bookshelf"),
    "model.businessman.cabinet": (path: "original/counting/businessman_cabinet.glb", procedural: "businessman.cabinet", note: "archive cabinet with labelled drawers"),
    "model.businessman.low_cabinet": (path: "original/counting/businessman_low_cabinet.glb", procedural: "businessman.low_cabinet"),
    "model.businessman.side_desk": (path: "original/counting/businessman_side_desk.glb", procedural: "businessman.side_desk"),
    "model.businessman.table": (path: "original/counting/businessman_table.glb", procedural: "businessman.table"),
    "model.businessman.stool": (path: "original/counting/businessman_stool.glb", procedural: "businessman.stool"),
    "model.businessman.armillary": (path: "original/counting/businessman_armillary.glb", procedural: "businessman.armillary", note: "armillary sphere, ~0.6 m tall"),
    "model.businessman.chart_north": (path: "original/counting/businessman_chart_north.glb", procedural: "businessman.chart_north", note: "wall chart 0.9 x 0.7, faces +Z, centred"),
    "model.businessman.chart_moon": (path: "original/counting/businessman_chart_moon.glb", procedural: "businessman.chart_moon"),
    "model.businessman.chart_constellation": (path: "original/counting/businessman_chart_constellation.glb", procedural: "businessman.chart_constellation"),
    "model.businessman.chart_zodiac": (path: "original/counting/businessman_chart_zodiac.glb", procedural: "businessman.chart_zodiac"),
    "model.businessman.chart_orbits": (path: "original/counting/businessman_chart_orbits.glb", procedural: "businessman.chart_orbits"),
    "model.businessman.lantern": (path: "original/counting/businessman_lantern.glb", procedural: "businessman.lantern", note: "wall lantern on a bracket; named part 'flame'"),
    "model.businessman.oil_lamp": (path: "original/counting/businessman_oil_lamp.glb", procedural: "businessman.oil_lamp"),
    "model.businessman.candles": (path: "original/counting/businessman_candles.glb", procedural: "businessman.candles"),
    "model.businessman.sextant": (path: "original/counting/businessman_sextant.glb", procedural: "businessman.sextant"),
    "model.businessman.scrolls": (path: "original/counting/businessman_scrolls.glb", procedural: "businessman.scrolls"),
    "model.businessman.boxes": (path: "original/counting/businessman_boxes.glb", procedural: "businessman.boxes"),

    // ------------------------------------------------------------------ outside
    "model.businessman.float_rock": (path: "original/counting/businessman_float_rock.glb", procedural: "businessman.float_rock", note: "one of the 28 floating rocks (Kenney Nature Kit, CC0)"),

    // ------------------------------------------------------------ telescope sky
    "model.businessman.b612_view": (procedural: "businessman.b612_view", note: "B-612 as seen through the 12° lens: radius 1, faces +Z, should be unlit"),
    "tex.businessman.glow": (procedural: "glow", note: "white RGBA radial glow (warm star halo); any square PNG with alpha"),
    "tex.businessman.flare": (procedural: "flare", note: "four-point star flare"),
    "tex.businessman.dot": (procedural: "dot", note: "small round dot (star core, stars, meteor)"),

    // -------------------------------------------------------------------- sounds
    "sfx.businessman.latch": (path: "original/audio/counting_Door_Latch.ogg", procedural: "click", volume: 0.7),
    "sfx.businessman.creak": (path: "original/audio/counting_Door_Creak.ogg", procedural: "creak", volume: 0.6, note: "door creak"),
    "sfx.businessman.settle": (path: "original/audio/counting_Door_Settle.ogg", procedural: "click", volume: 0.5),
    "sfx.businessman.scratch": (path: "original/audio/counting_Merchant_Writing_Loop.ogg", procedural: "tick", volume: 0.3, note: "pencil scratch of the write loop"),
    "sfx.businessman.lens": (path: "audio/sfx/toggle_001.ogg", procedural: "whoosh", volume: 0.5),
    "sfx.businessman.click": (path: "audio/sfx/click_001.ogg", procedural: "click", volume: 0.5),
    "sfx.businessman.chime": (procedural: "chime", volume: 0.35, note: "B-612 found"),
  },
)
