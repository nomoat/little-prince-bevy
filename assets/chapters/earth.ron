#![enable(implicit_some)]
// Asset keys of chapter "earth" (edited only by that chapter). Same format as
// assets/manifest.ron; see docs/ASSETS.md.
// Size convention: metres, +Y up, front faces +Z, origin at the base centre.
// Keys with `path` use CC0 Kenney Nature Kit models (scaled to real size here);
// every key keeps a `procedural` fallback of the same size.
(
  entries: {
    // ------------------------------------------------------------ music / sound
    "music.earth": (procedural: "pad_desert", volume: 0.55, looped: true, note: "valley (quiet, original −33.6 LUFS)"),
    "music.earth_dunes": (procedural: "pad_melancholy", volume: 0.75, looped: true, note: "dunes (original −24 LUFS)"),
    "music.earth_end": (procedural: "pad_ending", volume: 0.8, looped: true, note: "end card"),
    "sfx.earth.whistle": (path: "audio/sfx/impactBell_heavy_000.ogg", procedural: "bell", volume: 0.8, note: "train whistle on boarding"),
    "sfx.earth.train": (procedural: "whoosh", volume: 0.7, note: "train arriving in the dunes"),
    "sfx.earth.creak": (path: "audio/sfx/impactPlank_medium_000.ogg", procedural: "creak", volume: 0.8, note: "one windlass creak at the well (vol 0.8)"),
    "sfx.earth.echo": (procedural: "chime_low", volume: 0.5, note: "the mountain echo"),

    // ------------------------------------------------------------ cast
    "model.earth.snake": (procedural: "earth.snake", note: "coiled snake ~1 m; part 'neck' pivots at the coil top (raise/head-look)"),
    "model.earth.fox": (procedural: "earth.fox", note: "fox ~0.75 m long; parts body/head/tail/leg_fl/leg_fr/leg_bl/leg_br"),
    "model.earth.pilot": (procedural: "earth.pilot", note: "aviator ~1.75 m; parts torso/head/arm_l/arm_r/thigh_l/thigh_r/shin_l/shin_r"),
    "model.earth.flower": (procedural: "earth.flower", note: "three-petal desert flower ~0.3 m"),

    // ------------------------------------------------------------ valley
    "model.earth.snake_rock": (procedural: "earth.snake_rock", note: "the snake's rock, top 0.30 m"),
    "model.earth.peak": (path: "models/nature/rock_tallA.glb", procedural: "earth.peak", scale: 10.0, note: "rock spire ~10 m (the echo mountains)"),
    "model.earth.boulder": (path: "models/nature/rock_largeA.glb", procedural: "earth.boulder", scale: 2.6),
    "model.earth.cactus": (path: "models/nature/cactus_tall.glb", procedural: "earth.cactus", scale: 2.4, note: "~1.8 m"),
    "model.earth.cactus_s": (path: "models/nature/cactus_short.glb", procedural: "earth.cactus_s", scale: 2.0, note: "~1.05 m"),
    "model.earth.bush": (path: "models/nature/plant_bushLarge.glb", procedural: "earth.bush", scale: 3.0),
    "model.earth.wheat": (path: "models/nature/crops_wheatStageB.glb", procedural: "earth.wheat", scale: 1.7, note: "wheat clump ~0.9 m"),
    "model.earth.fence": (path: "models/nature/fence_simple.glb", procedural: "earth.crop", scale: 1.8),
    "model.earth.waterfall": (procedural: "earth.waterfall", note: "rocks + falling water ~3 m"),
    "model.earth.dune_grass": (procedural: "earth.dune_grass"),
    "model.earth.crop": (procedural: "earth.crop", note: "vegetable row 1.8 m"),
    "model.earth.apple_tree": (procedural: "earth.apple_tree", note: "apple tree ~4.6 m"),
    "model.earth.rose_bed": (procedural: "earth.rose_bed", note: "rose bed 1.9 × 1.0 m"),
    "model.earth.garden_wall": (procedural: "earth.garden_wall", note: "2 m wall segment along X, roses on top"),
    "model.earth.hedge": (procedural: "earth.hedge", note: "2 m hedge segment along X"),
    "model.earth.gate": (procedural: "earth.gate", note: "open iron double gate, 2 m opening along X"),
    "model.earth.arch": (procedural: "earth.arch", note: "rose arch, 2 m opening along X"),
    "model.earth.fountain": (procedural: "earth.fountain", note: "basin radius ~1 m"),
    "model.earth.urn": (procedural: "earth.urn"),
    "model.earth.topiary": (procedural: "earth.topiary"),
    "model.earth.bridge": (procedural: "earth.bridge", note: "footbridge, deck 3.4 m along Z"),
    "model.earth.cottage": (procedural: "earth.cottage", note: "stone cottage 3.2 × 2.8 m"),
    "model.earth.signpost": (procedural: "earth.signpost", note: "way sign, arrows point +Z"),
    "model.earth.cairn": (procedural: "earth.cairn"),
    "model.earth.platform": (procedural: "earth.platform", note: "station platform 14 × 1.8 m (X × Z), top 0.3 m"),
    "model.earth.cabin": (procedural: "earth.cabin", note: "station cabin 3.2 × 2.4 m"),
    "model.earth.bench": (procedural: "earth.bench"),
    "model.earth.signal": (procedural: "earth.signal"),
    "model.earth.notice": (procedural: "earth.notice"),
    "model.earth.pole": (procedural: "earth.pole", note: "telegraph pole 4.2 m"),
    "model.earth.rail": (procedural: "earth.rail", note: "2 m track segment along Z"),
    "model.earth.buffer": (procedural: "earth.buffer"),
    "model.earth.loco": (procedural: "earth.loco", note: "steam locomotive 6.3 m along Z, front +Z"),
    "model.earth.carriage": (procedural: "earth.carriage", note: "carriage 6.5 m along Z"),
    "model.earth.star": (procedural: "earth.star", note: "golden star sprite ~1 m (billboarded, scaled in code)"),

    // ------------------------------------------------------------ dunes
    "model.earth.plane": (procedural: "earth.plane", note: "crashed monoplane, fuselage along Z ~6.4 m, span 9.4 m"),
    "model.earth.crate": (procedural: "earth.crate", note: "0.7 × 0.45 × 0.5 m"),
    "model.earth.wrench": (procedural: "earth.wrench"),
    "model.earth.bedroll": (procedural: "earth.bedroll", note: "2 m along Z, pillow at −Z"),
    "model.earth.well": (procedural: "earth.well", note: "stone well; parts 'bucket' and 'rope' are moved by the well rig"),
    "model.earth.stone_seat": (procedural: "earth.stone_seat"),
    "model.earth.column": (path: "models/nature/statue_column.glb", procedural: "earth.column", scale: 3.2, note: "column ~3.2 m"),
    "model.earth.column_broken": (path: "models/nature/statue_columnDamaged.glb", procedural: "earth.column_broken", scale: 3.2),
    "model.earth.block": (path: "models/nature/statue_block.glb", procedural: "earth.block", scale: 2.5),
    "model.earth.slab": (procedural: "earth.slab", note: "path slab 1.2 × 0.9 m"),
    "model.earth.doorway": (procedural: "earth.doorway", note: "pillars + lintel, 1.6 m opening along X"),
    "model.earth.ruin_wall": (procedural: "earth.ruin_wall", note: "2 m wall along X"),
    "model.earth.step": (procedural: "earth.step", note: "3 × 0.25 × 0.45 m (scaled in Y per step)"),
    "model.earth.landing": (procedural: "earth.landing", note: "4 × 0.75 × 2.4 m"),
    "model.earth.stardust": (procedural: "earth.stardust", note: "one dot of the stardust trail"),
    "model.earth.footprint": (procedural: "earth.footprint", note: "0.10 × 0.20 m print"),

    // ------------------------------------------------------------ images (set `path` to a .png to replace)
    "image.earth.sketch_old_sheep": (procedural: "earth.sketch_old_sheep", note: "drawing panel: the old sheep (ink on transparent, square)"),
    "image.earth.sketch_box": (procedural: "earth.sketch_box", note: "drawing panel: the box with the sheep inside"),
  },
)
