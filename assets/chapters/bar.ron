#![enable(implicit_some)]
// Asset keys of chapter "bar" (edited only by that chapter). Same format as
// assets/manifest.ron; see docs/ASSETS.md. Models are procedural until you set
// `path` to your own .glb (keep the noted size / facing / origin).
(
  entries: {
    "music.bar": (procedural: "pad_night", volume: 0.6, looped: true),
    "model.bar.tavern": (procedural: "bar.tavern", note: "tavern shell, origin at the front door plane; interior x±4 z 0.4..6.4, ceiling 2.6, upstairs floor 2.9 (colliders stay code-defined)"),
    "model.bar.door": (procedural: "bar.door", note: "front door leaf 1.3 x 2.2 m, centred in x, bottom at y=0"),
    "model.bar.door_back": (procedural: "bar.door_back", note: "back door leaf 1.0 x 2.2 m"),
    "model.bar.table": (procedural: "bar.table", note: "the drinker's table 1.0 x 0.86 m (top 0.75) with bottles and the pendant lamp"),
    "model.bar.chair_high": (procedural: "bar.chair_high", note: "high guest chair, seat 0.46 m, faces +z"),
    "model.bar.chair": (procedural: "bar.chair", note: "the drinker's chair"),
    "model.bar.drinker": (procedural: "bar.drinker", note: "seated drinker, origin on the floor under the seat, faces +z; named parts torso/head/arm_l/arm_r/bottle/liquid are animated"),
    "model.bar.moon": (procedural: "bar.moon", note: "the moon (12 m sphere, far away)"),
    "model.bar.smoke": (procedural: "bar.smoke", note: "one chimney smoke puff"),
    "model.bar.barrel": (procedural: "bar.barrel", note: "yard barrel 0.9 m"),
    // generated WAVs (tests/gen_vbg_sfx.py), CC0 by this project
    "sfx.bar.gulp": (path: "chapters/bar/gulp.wav", procedural: "pop", volume: 0.8),
    "sfx.bar.clink": (path: "chapters/bar/clink.wav", procedural: "chime", volume: 0.6),
  },
)
