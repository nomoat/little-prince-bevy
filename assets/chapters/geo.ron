#![enable(implicit_some)]
// Original assets imported from ~/lp_extract. The procedural generators
// remain as fallbacks. See original/import-report.json and docs/ASSETS.md.
(
  entries: {
    "music.geo": (path: "original/audio/geo_Geography_Music.ogg", procedural: "pad_wonder", volume: 0.6, looped: true),
    "model.geo.library": (path: "original/geo/geo_library.glb", procedural: "geo.library", note: "map library shell in world coords: floor y=0, hall x±4 z 0.6..12, balcony rail z=15.3 (colliders stay code-defined)"),
    "model.geo.door": (path: "original/geo/geo_door.glb", procedural: "geo.door", note: "front door leaf 1.3 x 2.8 m (fixed open)"),
    "model.geo.tower": (procedural: "geo.tower", note: "round tower, r 1.9 m, ~12 m tall"),
    "model.geo.table": (path: "original/geo/geo_table.glb", procedural: "geo.table", note: "map table 1.6 x 1.1 m, top 0.8, with map, book, armillary sphere, pencil stand"),
    "model.geo.geographer": (path: "original/geo/geo_geographer.glb", procedural: "geo.geographer", note: "seated geographer, faces +z; named parts torso/head/arm_l/arm_r/pencil are animated"),
    "model.geo.cypress": (path: "original/geo/geo_cypress.glb", procedural: "geo.cypress", note: "cypress ~4.8 m"),
    "model.geo.bed": (procedural: "geo.bed", note: "raised garden bed 2.4 x 1.8 m"),
    "model.geo.clouds": (procedural: "geo.clouds", note: "sea of clouds, origin at y=-55"),
    "model.geo.beam": (procedural: "geo.beam", note: "skylight sunbeam (transparent)"),
    // generated WAV (tests/gen_vbg_sfx.py), CC0 by this project
    "sfx.geo.pencil": (path: "original/audio/geo_Pencil_Writing_Loop.ogg", procedural: "tick", volume: 0.7),
  },
)
