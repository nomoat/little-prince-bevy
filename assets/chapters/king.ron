#![enable(implicit_some)]
// Original assets imported from ~/lp_extract. The procedural generators
// remain as fallbacks. See original/import-report.json and docs/ASSETS.md.
(
  entries: {
    "music.king": (path: "original/audio/king_King_Music.ogg", procedural: "pad_playful", volume: 0.7, looped: true),
    "model.king.king": (path: "original/king/king_king.glb", procedural: "king.king", note: "the seated King (faces +Z, origin on the dais under his seat); parts king_body/king_head/king_arm_r/king_arm_l/king_book are animated"),
    "model.king.throne": (path: "original/king/king_throne.glb", procedural: "king.throne", note: "high-backed throne, front +Z, seat at 0.5 m"),
    "model.king.candelabrum": (path: "original/king/king_candelabrum.glb", procedural: "king.candelabrum", note: "three-armed candelabrum ~1.7 m; part 'flames'"),
    "model.king.door": (path: "original/king/king_door.glb", procedural: "king.door", note: "one door leaf 1.4 x 2.4 m, origin at the leaf's bottom centre (hinge at x = -0.7)"),
    "model.king.column": (procedural: "king.column", note: "hall column ~4.8 m"),
    "model.king.banner": (path: "original/king/king_banner.glb", procedural: "king.banner", note: "hanging banner, faces +Z"),
    "model.king.tower": (procedural: "king.tower", note: "palace corner tower ~9 m"),
    "model.king.cushion": (procedural: "king.cushion", note: "velvet footstool (decor)"),
    "sfx.king.creak": (path: "original/audio/king_Door_Creak.ogg", procedural: "creak", volume: 0.8),
    "sfx.king.latch": (path: "original/audio/king_Door_Latch.ogg", procedural: "click", volume: 0.7),
  },
)
